{
  "name": "panoptrain",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:server": "pnpm --filter @panoptrain/server dev",
    "dev:client": "pnpm --filter @panoptrain/client dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm --filter @panoptrain/e2e test:e2e",
    "download-gtfs": "pnpm --filter @panoptrain/server download-gtfs",
    "download-gtfs:lirr": "pnpm --filter @panoptrain/server download-gtfs:lirr",
    "lint:fix": "eslint . --fix",
    "test:coverage": "pnpm -r --if-present test:coverage"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.0.1",
    "globals": "^17.11.0",
    "typescript-eslint": "^8.68.0"
  }
}
