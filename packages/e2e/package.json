{
  "name": "@panoptrain/e2e",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:prod": "pnpm --filter @panoptrain/client build && playwright test --config playwright.prod.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "playwright:install": "playwright install --with-deps chromium",
    "profile:flakes": "tsx scripts/profile-flakes.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.1",
    "tsx": "^4.23.13"
  }
}
