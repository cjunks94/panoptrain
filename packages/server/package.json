{
  "name": "@panoptrain/server",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:e2e": "tsx watch src/index-e2e.ts",
    "start": "tsx src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "download-gtfs": "tsx scripts/download-gtfs.ts",
    "download-gtfs:lirr": "tsx scripts/download-gtfs.ts lirr",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "@panoptrain/shared": "workspace:*",
    "@turf/along": "^7.4.0",
    "@turf/bearing": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "@turf/length": "^7.4.0",
    "@turf/nearest-point-on-line": "^7.4.0",
    "csv-parse": "^7.0.2",
    "dotenv": "^17.4.2",
    "gtfs-realtime-bindings": "^2.2.0",
    "hono": "^4.13.1",
    "jszip": "^3.10.0",
    "protobufjs": "^8.7.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "msw": "^2.15.0",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
